# ---- xTractor environment (names only — copy to .env.local and fill) ----

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://xtractor.inakilozano.com
AUTH_URL=https://xtractor.inakilozano.com
AUTH_SECRET=               # 32+ chars random — `openssl rand -base64 32`
AUTH_TRUST_HOST=true

# Postgres (used by app + migrate runner)
POSTGRES_USER=xtractor
POSTGRES_PASSWORD=         # strong password
POSTGRES_DB=xtractor_db
DATABASE_URL=              # postgresql://xtractor:<password>@postgres:5432/xtractor_db

# Admin seed (idempotent — run at boot). Leave ADMIN_PASSWORD set in .env.local.
ADMIN_EMAIL=ilozano@inakilozano.com
ADMIN_PASSWORD=            # strong initial password for the admin user

# Cookie-at-rest encryption (AES-256-GCM). 32-byte key, hex or base64.
# Generate: openssl rand -hex 32
COOKIE_ENC_KEY=

# Python scraper sidecar (internal Docker DNS; never published)
SCRAPER_URL=http://scraper:8000
SCRAPER_TOKEN=             # shared bearer token between app and scraper

# SMTP / Email (same names as the portfolio repo)
SMTP_SERVER=
SMTP_PORT=465
SMTP_ENCRYPT=SSL
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_MAIL_FROM=
