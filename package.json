{
  "name": "xtractor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --incremental false",
    "typecheck:docker": "docker build -f Dockerfile --target typecheck -t xtractor:typecheck .",
    "db:generate": "drizzle-kit generate",
    "test:instant": "playwright test --config playwright.instant.config.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "portfolio-nodemailer": "npm:nodemailer@10.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/playwright": "16.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
